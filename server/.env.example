# DeepSeek API key for AI-powered product search
# Get your key at https://platform.deepseek.com/api_keys
# Leave empty to use keyword-based fallback search
DEEPSEEK_API_KEY=

# SMTP settings for email (invoices, invites)
# Leave empty to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Client URL for invite links
CLIENT_URL=http://localhost:3000
